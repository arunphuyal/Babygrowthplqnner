# /etc/systemd/system/pottytrain-api.service   (Linux VPS or cPanel VPS with root access)
# sudo systemctl daemon-reload && sudo systemctl enable --now pottytrain-api
[Unit]
Description=API
After=network.target

[Service]
WorkingDirectory=/opt/api
ExecStart=/opt/api/PottyTrain.Api
Restart=always
RestartSec=5
User=apiuser
EnvironmentFile=/etc/pottytrain-api.env
# Listen only on localhost; the reverse proxy (Caddy/Apache) exposes it over HTTPS.
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000
Environment=ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/pottytrain

[Install]
WantedBy=multi-user.target
