# /etc/babybunu-api.env  (chmod 600, owned by root). Never commit the real file.
Jwt__Key=CHANGE_ME_generate_with__openssl_rand_-base64_48
Seed__AdminEmail=you@yourdomain.com
Seed__AdminPassword=CHOOSE_A_LONG_PASSPHRASE
ConnectionStrings__Default=Data Source=/var/lib/babybunu/app.db
Cors__Origins__0=https://yourdomain.com
Cors__Origins__1=https://www.yourdomain.com
Cors__Origins__2=https://admin.yourdomain.com
App__Name=YourBrand
App__ResetUrl=https://yourdomain.com/reset-password
Email__SmtpHost=mail.yourdomain.com
Email__SmtpPort=587
Email__User=no-reply@yourdomain.com
Email__Password=MAILBOX_PASSWORD
Email__From=no-reply@yourdomain.com
Donations__StripeSecretKey=
Donations__StripeWebhookSecret=
Donations__SuccessUrl=https://yourdomain.com/?donation=thanks
Donations__CancelUrl=https://yourdomain.com/?donation=cancelled
