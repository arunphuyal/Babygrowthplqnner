# /etc/systemd/system/babybunu-api.service   (installed by deploy/bootstrap-vps.sh)
[Unit]
Description=Babybunu API
After=network.target

[Service]
# "current" is a symlink to the active release, so deploy-vps.sh can switch versions and roll back instantly.
WorkingDirectory=/opt/babybunu/current
ExecStart=/opt/babybunu/current/Babybunu.Api
Restart=always
RestartSec=5
User=babybunu
EnvironmentFile=/etc/babybunu-api.env
Environment=ASPNETCORE_ENVIRONMENT=Production
# Listen only on localhost; Caddy exposes it over HTTPS.
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000
Environment=ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/babybunu

[Install]
WantedBy=multi-user.target
