# Copy to .env.local (or set in your host's build settings).
VITE_API_URL=https://api.yourdomain.com
# Working name until the brand is final:
VITE_SITE_NAME=PottyTrain
VITE_SITE_URL=https://yourdomain.com
VITE_CONTACT_EMAIL=hello@yourdomain.com
# Leave empty to show no ads / load no tags. Everything optional loads only after visitor consent.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=
# Google tag ID (G-..., GT-... or AW-...). Loads only after the visitor allows analytics or ads.
VITE_GOOGLE_TAG_ID=
VITE_META_PIXEL_ID=
# Used only by `npm run build` (prerender + sitemap): where to read the guides from.
PRERENDER_API_URL=http://localhost:5080
